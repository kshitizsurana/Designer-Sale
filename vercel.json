{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/:match*",
      "destination": "/admin.html"
    },
    {
      "source": "/",
      "destination": "/DesignerSale Standalone Source.html"
    },
    {
      "source": "/:path*",
      "destination": "/DesignerSale Standalone Source.html"
    }
  ]
}
