{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/DesignerSale Standalone Source.html"
    },
    {
      "source": "/admin/:match*",
      "destination": "/admin.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
